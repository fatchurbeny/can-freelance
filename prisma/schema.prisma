generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String?      @unique
  passwordHash   String?      @map("password_hash")
  name           String?
  role           String       @default("manager")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Login ID + PIN (docs/knowledge/user-role-spec.md): "FT-001" full-time, "FL-014" freelance.
  userCode       String?      @unique @map("user_code")
  employmentType String?      @map("employment_type") // FULL_TIME | FREELANCE
  pinHash        String?      @map("pin_hash")
  pinMustChange  Boolean      @default(true) @map("pin_must_change")
  pinChangedAt   DateTime?    @map("pin_changed_at") @db.Timestamptz(6)
  failedAttempts Int          @default(0) @map("failed_attempts")
  lockedUntil    DateTime?    @map("locked_until") @db.Timestamptz(6)
  isActive       Boolean      @default(true) @map("is_active")
  lastLoginAt    DateTime?    @map("last_login_at") @db.Timestamptz(6)
  designerId     String?      @unique @map("designer_id") @db.Uuid
  designer       Designer?    @relation(fields: [designerId], references: [id])
  memberships    Membership[]
  sessions       Session[]

  @@map("users")
}

/// Role melekat pada keanggotaan di production; productionUnitId null = global.
/// Role & permission didefinisikan di src/lib/permissions.ts (roleKey).
model Membership {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  roleKey          String          @map("role_key")
  productionUnitId String?         @map("production_unit_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productionUnit   ProductionUnit? @relation(fields: [productionUnitId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("memberships")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Designer {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notionKey         String              @unique @map("notion_key")
  displayName       String              @map("display_name")
  avatarColor       String?             @map("avatar_color")
  status            String              @default("Active")
  role              String?             @default("Junior Designer")
  contractType      String?             @default("Freelance") @map("contract_type")
  contractStartDate DateTime?           @map("contract_start_date") @db.Date
  probationEndDate  DateTime?           @map("probation_end_date") @db.Date
  inactiveStartDate DateTime?           @map("inactive_start_date") @db.Date
  inactiveNote      String?             @map("inactive_note")
  resignDate        DateTime?           @map("resign_date") @db.Date
  promotionDate     DateTime?           @map("promotion_date") @db.Date
  email             String?
  phone             String?
  bankName          String?             @map("bank_name")
  bankAccount       String?             @map("bank_account")
  payrollStatuses   PayrollStatus[]
  isAgency          Boolean             @default(false) @map("is_agency")
  tasks             Task[]
  careerLogs        DesignerCareerLog[]
  bundleOrders      BundleOrder[]
  bundleContracts   BundleContract[]
  user              User?

  @@map("designers")
}

model DesignerCareerLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  designerId  String   @map("designer_id") @db.Uuid
  eventType   String   @map("event_type")
  title       String
  description String?
  eventDate   DateTime @map("event_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  designer Designer @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@map("designer_career_logs")
}

model Doctype {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notionKey       String       @map("notion_key")
  platformId      String       @map("platform_id") @db.Uuid
  displayName     String       @map("display_name")
  isTopSpecialist Boolean      @default(false) @map("is_top_specialist")
  sortOrder       Int          @default(0) @map("sort_order")
  poolRate        Float        @default(1.0) @map("pool_rate")
  pages           Float?
  category        String?      @default("Infografis")
  dimensions      String?      @default("1920x1080 px")
  aspectRatio     String?      @default("16:9") @map("aspect_ratio")
  notes           String?
  isActive        Boolean      @default(true) @map("is_active")
  /// Kegunaan: "Kontrak" (pool score + tarif platform), "Bundle" (harga paket, pool score 0), atau "Keduanya".
  usage           String       @default("Kontrak")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tasks           Task[]
  platform        Platform     @relation(fields: [platformId], references: [id])
  bundleItems     BundleItem[]

  @@unique([platformId, notionKey])
  @@map("doctypes")
}

model Account {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notionKey          String                   @map("notion_key")
  platformId         String                   @map("platform_id") @db.Uuid
  displayName        String                   @map("display_name")
  color              String?
  taskAccounts       TaskAccount[]
  emailNotifications CanvaEmailNotification[]
  platform           Platform                 @relation(fields: [platformId], references: [id])

  @@unique([platformId, notionKey])
  @@map("accounts")
}

model DesignStatus {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notionKey           String  @unique @map("notion_key")
  displayName         String  @map("display_name")
  statusGroup         String? @map("status_group")
  countsAsSubmitted   Boolean @default(true) @map("counts_as_submitted")
  countsAsApproved    Boolean @default(false) @map("counts_as_approved")
  countsAsProfileOnly Boolean @default(false) @map("counts_as_profile_only")
  tasks               Task[]

  @@map("design_statuses")
}

model Task {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notionPageId     String          @unique @map("notion_page_id")
  notionUrl        String?         @map("notion_url")
  name             String?
  designerId       String?         @map("designer_id") @db.Uuid
  doctypeId        String?         @map("doctype_id") @db.Uuid
  designStatusId   String?         @map("design_status_id") @db.Uuid
  pages            Decimal?        @db.Decimal
  qtySubmit        Decimal?        @map("qty_submit") @db.Decimal
  license          String?
  languages        String[]
  dateApproved     DateTime?       @map("date_approved") @db.Date
  taskMonth        String?         @map("task_month")
  payrollMonth     String?         @map("payroll_month")
  priority         String?
  createdTime      DateTime        @map("created_time") @db.Timestamptz(6)
  syncedAt         DateTime        @default(now()) @map("synced_at") @db.Timestamptz(6)
  dateCompleted    DateTime?       @map("date_completed") @db.Date
  datePO           DateTime?       @map("date_po") @db.Date
  dateReject       DateTime?       @map("date_reject") @db.Date
  dateStarted      DateTime?       @map("date_started") @db.Date
  lastEditedTime   DateTime        @default(now()) @map("last_edited_time") @db.Timestamptz(6)
  poolScore        Decimal?        @map("pool_score") @db.Decimal
  bodyText         String?         @map("body_text")
  syncStatus       String          @default("SYNCED") @map("sync_status")
  lastSyncedAt     DateTime?       @map("last_synced_at") @db.Timestamptz(6)
  productionUnitId String          @map("production_unit_id") @db.Uuid
  customFields     Json?           @map("custom_fields")
  outputUrl        String?         @map("output_url")
  uploadRequestUrl String?         @map("upload_request_url")
  bundleId         String?         @map("bundle_id") @db.Uuid
  bundleItemId     String?         @map("bundle_item_id") @db.Uuid
  bundleOrderId    String?         @map("bundle_order_id") @db.Uuid
  bundle           Bundle?         @relation(fields: [bundleId], references: [id])
  bundleItem       BundleItem?     @relation(fields: [bundleItemId], references: [id])
  bundleOrder      BundleOrder?    @relation(fields: [bundleOrderId], references: [id])
  productionUnit   ProductionUnit  @relation(fields: [productionUnitId], references: [id])
  taskAccounts     TaskAccount[]
  canvaLinks       TaskCanvaLink[]
  assetLinks       TaskAsset[]
  comments         TaskComment[]
  shareLinks       TaskShareLink[]
  designStatus     DesignStatus?   @relation(fields: [designStatusId], references: [id])
  designer         Designer?       @relation(fields: [designerId], references: [id])
  doctype          Doctype?        @relation(fields: [doctypeId], references: [id])

  @@index([productionUnitId])
  @@index([bundleOrderId])
  @@map("tasks")
}

/// Link publik view-only untuk satu task (/share/t/<token>). Tanpa kedaluwarsa; dicabut via revokedAt.
model TaskShareLink {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  token       String    @unique
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_share_links")
}

model TaskCanvaLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  url       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_canva_links")
}

model TaskComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

model TaskAccount {
  taskId    String  @map("task_id") @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, accountId])
  @@map("task_accounts")
}

model PayrollStatus {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  designerId   String   @map("designer_id") @db.Uuid
  payrollMonth String   @map("payroll_month")
  isPaid       Boolean  @default(false) @map("is_paid")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  designer     Designer @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@unique([designerId, payrollMonth])
  @@map("payroll_statuses")
}

model SyncLog {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  status        String
  recordsSynced Int?      @map("records_synced")
  errorMessage  String?   @map("error_message")
  mode          String    @default("incremental")

  @@map("sync_logs")
}

model NotionDatabase {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String       @default("Database")
  encryptedDatabaseId String       @map("encrypted_database_id")
  iv                  String
  configId            String       @map("config_id") @db.Uuid
  /// Disembunyikan dari daftar & tidak dipakai sebagai database default; tetap terdaftar, data Notion tidak disentuh.
  archived            Boolean      @default(false)
  /// Page induk di Notion (ID 32 hex) bila diketahui.
  parentPageId        String?      @map("parent_page_id")
  /// Kegunaan khusus; "asset_library" = database mirror Asset Library (maks. satu yang aktif).
  purpose             String?
  config              NotionConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@map("notion_databases")
}

/// Page Notion tempat database Task baru dibuat (wizard production). Satu page ditandai default.
model NotionPage {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configId  String       @map("config_id") @db.Uuid
  name      String
  pageId    String       @unique @map("page_id") // ID 32 hex tanpa tanda hubung
  isDefault Boolean      @default(false) @map("is_default")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  config    NotionConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@map("notion_pages")
}

model NotionConfig {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encryptedApiKey String           @map("encrypted_api_key")
  iv              String
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  autoSync        Boolean          @default(false) @map("auto_sync")
  syncInterval    String           @default("15_mins") @map("sync_interval")
  workspaceName   String           @map("workspace_name")
  contractRate    Int              @default(15000) @map("contract_rate")
  databases       NotionDatabase[]
  pages           NotionPage[]

  @@map("notion_configs")
}

model CanvaEmailNotification {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId     String   @unique @map("message_id")
  subject       String   @default("We’ve found some issues with your template")
  sender        String   @default("Canva <notifications@canva.com>")
  recipient     String?
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  brandName     String?  @map("brand_name")
  accountId     String?  @map("account_id") @db.Uuid
  templateTitle String?  @map("template_title")
  templateUrl   String?  @map("template_url")
  issueMessages String[] @map("issue_messages")
  rawBody       String?  @map("raw_body")
  status        String   @default("UNRESOLVED")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@map("canva_email_notifications")
}

model EmailConfig {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider            String    @default("IMAP") // "IMAP" | "GMAIL_OAUTH"
  email               String
  imapHost            String?   @map("imap_host")
  imapPort            Int?      @default(993) @map("imap_port")
  encryptedPassword   String?   @map("encrypted_password")
  encryptedOAuthToken String?   @map("encrypted_oauth_token")
  iv                  String?
  authStatus          String    @default("DISCONNECTED") @map("auth_status")
  lastAuthErrorCode   String?   @map("last_auth_error_code")
  lastAuthError       String?   @map("last_auth_error")
  autoSync            Boolean   @default(true) @map("auto_sync")
  lastSyncedAt        DateTime? @map("last_synced_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("email_configs")
}

model SyncSubjectTrigger {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject     String   @unique
  isActive    Boolean  @default(true) @map("is_active")
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("sync_subject_triggers")
}

// ── Multi-Production (docs/knowledge/multi-production-plan.md) ──
model Platform {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String           @unique
  outputType        String           @default("canva_link") @map("output_type") // "canva_link" | "dropbox_link"
  baseRate          Int?             @map("base_rate") // tarif dasar per halaman; null = fallback NotionConfig.contractRate
  contractStartDate DateTime?        @map("contract_start_date") @db.Date
  /// Akhir periode kontrak (inklusif); null = tanpa tanggal akhir.
  contractEndDate   DateTime?        @map("contract_end_date") @db.Date
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  productionUnits   ProductionUnit[]
  doctypes          Doctype[]
  accounts          Account[]

  @@map("platforms")
}

model ProductionUnit {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  slug               String            @unique
  platformId         String            @map("platform_id") @db.Uuid
  notionTaskDbId     String            @map("notion_task_db_id")
  notionParentPageId String?           @map("notion_parent_page_id")
  fieldMapping       Json              @default("{}") @map("field_mapping")
  disabledFields     String[]          @default([]) @map("disabled_fields") // FieldKey inti yang dimatikan (bukan field wajib)
  dropboxRoot        String?           @map("dropbox_root")
  isActive           Boolean           @default(true) @map("is_active")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  platform           Platform          @relation(fields: [platformId], references: [id])
  tasks              Task[]
  bundleItems        BundleItem[]
  memberships        Membership[]
  fields             ProductionField[]
  assets             AssetProduction[]

  @@map("production_units")
}

// Field tambahan per production (di luar field inti). Nilai task disimpan di Task.customFields dengan key = name.
model ProductionField {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionUnitId String         @map("production_unit_id") @db.Uuid
  name             String // nama properti di Notion
  notionPropertyId String?        @map("notion_property_id")
  type             String // tipe properti Notion (rich_text, select, date, ...)
  options          Json? // [{ name, color }] untuk select / multi_select / status
  source           String         @default("app") // "app" | "notion"
  visible          Boolean        @default(true)
  editable         Boolean        @default(true)
  filterable       Boolean        @default(false)
  missingInNotion  Boolean        @default(false) @map("missing_in_notion")
  sortOrder        Int            @default(0) @map("sort_order")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  productionUnit   ProductionUnit @relation(fields: [productionUnitId], references: [id], onDelete: Cascade)

  @@unique([productionUnitId, name])
  @@map("production_fields")
}

// ── Dropbox (multi-production Fase 6) ──
// Satu koneksi akun Dropbox untuk seluruh app. Refresh token dienkripsi (lib/encryption.ts).
model DropboxConnection {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String   @map("account_id")
  accountEmail          String?  @map("account_email")
  encryptedRefreshToken String   @map("encrypted_refresh_token")
  iv                    String
  connectedAt           DateTime @default(now()) @map("connected_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("dropbox_connections")
}

/// Kontrak multi-platform: satu harga paket (bayaran designer) untuk beberapa komponen.
model Bundle {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  price         Decimal          @db.Decimal(14, 2)
  effectiveFrom DateTime?        @map("effective_from") @db.Date
  notes         String?
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items         BundleItem[]
  orders        BundleOrder[]
  contracts     BundleContract[]
  tasks         Task[]

  @@map("bundles")
}

/// Komponen bundle = satu task di satu board (ProductionUnit).
model BundleItem {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bundleId         String         @map("bundle_id") @db.Uuid
  productionUnitId String         @map("production_unit_id") @db.Uuid
  doctypeId        String         @map("doctype_id") @db.Uuid
  pages            Float
  sortOrder        Int            @default(0) @map("sort_order")
  bundle           Bundle         @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productionUnit   ProductionUnit @relation(fields: [productionUnitId], references: [id])
  doctype          Doctype        @relation(fields: [doctypeId], references: [id])
  tasks            Task[]

  @@index([bundleId])
  @@map("bundle_items")
}

/// Satu pemesanan bundle; harga di-snapshot saat order dibuat. Tampil di Billing Statement seksi Bundle.
model BundleOrder {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bundleId          String          @map("bundle_id") @db.Uuid
  designerId        String?         @map("designer_id") @db.Uuid
  period            String?
  price             Decimal         @db.Decimal(14, 2)
  status            String          @default("Open")
  /// "Trial" atau "Kontrak". Order kontrak = satu periode dari `BundleContract` (`contractId`).
  orderType         String          @default("Trial") @map("order_type")
  /// Bulan payout ke designer; null = belum diset, masuk antrian Closing. Bisa sama/beda dengan `period`.
  payoutMonth       String?         @map("payout_month")
  /// "Full" = lunas sekali bayar; "DP" = bayar uang muka dulu, sisanya saat pelunasan.
  paymentType       String          @default("Full") @map("payment_type")
  dpAmount          Decimal         @default(0) @map("dp_amount") @db.Decimal(14, 2)
  dpPaidAt          DateTime?       @map("dp_paid_at") @db.Timestamptz(6)
  paidAt            DateTime?       @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Order periode dari kontrak bundle (null = trial / order kontrak lama).
  contractId        String?         @map("contract_id") @db.Uuid
  bundle            Bundle          @relation(fields: [bundleId], references: [id])
  designer          Designer?       @relation(fields: [designerId], references: [id])
  contract          BundleContract? @relation("ContractOrders", fields: [contractId], references: [id])
  /// Kontrak yang lahir dari order trial ini.
  contractFromTrial BundleContract? @relation("ContractTrial")
  tasks             Task[]

  @@index([bundleId])
  @@index([contractId])
  @@map("bundle_orders")
}

/// Kontrak bundle setelah trial lolos (semua task approved). Order per periode dibuat manual di dalam periode ini.
model BundleContract {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bundleId          String        @map("bundle_id") @db.Uuid
  designerId        String?       @map("designer_id") @db.Uuid
  trialOrderId      String?       @unique @map("trial_order_id") @db.Uuid
  /// Harga per periode (default harga paket bundle saat kontrak dibuat).
  price             Decimal       @db.Decimal(14, 2)
  contractStartDate DateTime      @map("contract_start_date") @db.Date
  contractEndDate   DateTime      @map("contract_end_date") @db.Date
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  bundle            Bundle        @relation(fields: [bundleId], references: [id])
  designer          Designer?     @relation(fields: [designerId], references: [id])
  trialOrder        BundleOrder?  @relation("ContractTrial", fields: [trialOrderId], references: [id])
  orders            BundleOrder[] @relation("ContractOrders")

  @@index([bundleId])
  @@map("bundle_contracts")
}

// ── Asset Library (docs/backlog/resources-library.md) ──
/// Tab kategori di /assets (Icon, Ilustrasi, Template, Mockup, …).
model AssetCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  assets    Asset[]

  @@map("asset_categories")
}

/// Aset Canva. App = sumber input utama; dimirror dua arah ke database Notion "Asset Library".
model Asset {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  categoryId     String            @map("category_id") @db.Uuid
  tags           String[]          @default([])
  /// Link edit Canva (…/edit), butuh login akun tim.
  editUrl        String?           @map("edit_url")
  /// Public view link (…/view); preview iframe `?embed` tanpa login.
  previewUrl     String            @map("preview_url")
  coverUrl       String?           @map("cover_url")
  pages          Int?
  notes          String?
  status         String            @default("active") // "active" | "archived"
  source         String            @default("manual") // "manual" | "api"
  canvaDesignId  String?           @map("canva_design_id")
  notionPageId   String?           @unique @map("notion_page_id")
  syncStatus     String            @default("PENDING_PUSH") @map("sync_status") // SYNCED | PENDING_PUSH | ERROR
  lastSyncedAt   DateTime?         @map("last_synced_at") @db.Timestamptz(6)
  lastEditedTime DateTime          @default(now()) @map("last_edited_time") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category       AssetCategory     @relation(fields: [categoryId], references: [id])
  /// Production (platform Canva) yang boleh memakai aset; kosong = semua production Canva.
  productions    AssetProduction[]
  taskLinks      TaskAsset[]

  @@index([categoryId])
  @@index([previewUrl])
  @@map("assets")
}

/// Production yang boleh memakai aset (hanya production berplatform Canva).
model AssetProduction {
  assetId          String         @map("asset_id") @db.Uuid
  productionUnitId String         @map("production_unit_id") @db.Uuid
  asset            Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productionUnit   ProductionUnit @relation(fields: [productionUnitId], references: [id], onDelete: Cascade)

  @@id([assetId, productionUnitId])
  @@index([productionUnitId])
  @@map("asset_productions")
}

/// Aset yang dirujuk task (section "📦 Assets" di brief / relation "Assets" di Notion).
model TaskAsset {
  taskId    String   @map("task_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  /// Halaman yang dipakai, mis. "3, 7, 12"; null = semua.
  pages     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([taskId, assetId])
  @@index([assetId])
  @@map("task_assets")
}
