{
  "manifest_version": 3,
  "name": "Can-Freelance Canva Insights",
  "version": "1.4.0",
  "description": "Kirim Applies/Usages dashboard Canva Creator ke dashboard can-freelance (satu klik per brand).",
  "minimum_chrome_version": "116",
  "permissions": [
    "webRequest",
    "scripting",
    "storage",
    "notifications",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.canva.com/*",
    "https://portal.meetimpro.site/*",
    "https://portal.fatchurbeny.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Canva Insights",
    "default_icon": {
      "128": "icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "128": "icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "ui.css",
        "icon-128.png"
      ],
      "matches": [
        "https://www.canva.com/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "popup.html?sidebar=1"
  }
}
