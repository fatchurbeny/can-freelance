{
  "manifest_version": 3,
  "name": "Can-Freelance Canva Insights",
  "version": "1.2.0",
  "description": "Kirim Applies/Usages dashboard Canva Creator ke dashboard can-freelance (satu klik per brand).",
  "browser_specific_settings": {
    "gecko": {
      "id": "canva-insights@can-freelance",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "scripting",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://www.canva.com/*",
    "https://portal.meetimpro.site/*",
    "https://portal.fatchurbeny.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Canva Insights",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.canva.com/creators/*"
      ],
      "js": [
        "slideover.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "ui.css",
        "icon-128.png"
      ],
      "matches": [
        "https://www.canva.com/*"
      ]
    }
  ]
}
